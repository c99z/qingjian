# 复制为同目录的 .env 再改：cp env.example .env

# 服务器的主地址：IP 或域名，只写一个，客户端填 https://<这个地址>。
# 换 IP 后只改这一行再 docker compose up -d；自建 CA 不变，客户端无需重新信任证书。
QINGJIAN_SITE=192.168.1.10

# 附加地址（可空），空格分隔，例如同时还有域名：sync.example.com
# 客户端用 IP 直连时不带主机名，只能对上主地址的证书，所以第二个 IP 写在这里也连不上，请改用域名。
QINGJIAN_EXTRA_SITES=

# internal：Caddy 自建 CA 签发，适用于 IP、内网或还没有域名的情况，客户端需信任导出的根证书。
# 填邮箱（如 admin@example.com）：向 Let's Encrypt 申请，需要 QINGJIAN_SITE 是域名且公网能访问 80/443。
QINGJIAN_TLS=internal

# 宿主机端口。443 被占用时可改，例如 8443，客户端地址随之写成 https://<IP>:8443
QINGJIAN_HTTPS_PORT=443
QINGJIAN_HTTP_PORT=80

# open 开放注册；建好需要的账号后改成 closed 并 docker compose up -d 关掉注册。
QINGJIAN_REGISTRATION=open

# 本机回环上的明文端口，仅供宿主机排查或宿主机已有的反向代理使用。
QINGJIAN_LOCAL_PORT=9080

# RUST_LOG=info

# 拉不到 Docker Hub 时换成内网镜像仓库：
# QINGJIAN_RUST_IMAGE=rust:1.96-slim-trixie
# QINGJIAN_RUNTIME_IMAGE=debian:trixie-slim
# QINGJIAN_CADDY_IMAGE=caddy:2.10-alpine
# QINGJIAN_ACCOUNT_IMAGE=qingjian-account-server:local
